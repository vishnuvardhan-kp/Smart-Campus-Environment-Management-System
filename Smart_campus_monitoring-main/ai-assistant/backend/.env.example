# Smart Campus AI Assistant Environment Configuration
PORT=5005
CORS_ORIGIN=http://localhost:5175

# NVIDIA NIM LLM Configuration (OpenAI-compatible)
# Sign up at https://build.nvidia.com/ to get your personal API key (starts with nvapi-...)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# MongoDB Connection
# If left empty, assistant automatically reuses backend/.env MONGO_URI if available
MONGO_URI=
MONGODB_DB_NAME=smart_campus
DEFAULT_ROOM=LAB101
