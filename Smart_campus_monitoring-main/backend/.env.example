# Backend Environment Configuration Template
PORT=5000
MONGO_URI=mongodb://localhost:27017/smart_campus
MQTT_BROKER_URL=mqtts://your-hivemq-cluster.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
ESP32_ROOM=LAB101

# ==============================================================================
# MULTI-CHANNEL NOTIFICATION PIPELINE (EMAIL-FIRST, WHATSAPP-FALLBACK)
# ==============================================================================
# Dispatch sequence: 'email,whatsapp' (default) or 'sms'
NOTIFICATION_CHANNEL_ORDER=email,whatsapp

# Deduplication cooldown period in minutes across all channels
SMS_COOLDOWN_MINUTES=30

# ------------------------------------------------------------------------------
# 1. Primary Channel: Email (Mock-only by default)
# ------------------------------------------------------------------------------
# Provider mode: 'mock' (default), 'smtp', or 'sendgrid'
EMAIL_PROVIDER=mock
# HARD DELIVERY GATE: Must be explicitly 'true' to permit real outbound email
EMAIL_ENABLE_REAL_DELIVERY=false
# Placeholders for future SMTP / SendGrid configuration
# NOTE: Do not assume a free email quota exists without checking provider account limits
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=alerts@campus.edu

# ------------------------------------------------------------------------------
# 2. Fallback Channel: WhatsApp (Mock-only by default)
# ------------------------------------------------------------------------------
# Provider mode: 'mock' (default) or 'twilio'
WHATSAPP_PROVIDER=mock
# HARD DELIVERY GATE: Must be explicitly 'true' to permit real outbound WhatsApp
WHATSAPP_ENABLE_REAL_DELIVERY=false
# Dedicated WhatsApp Sender (NOTE: Twilio SMS credentials alone DO NOT enable WhatsApp)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ------------------------------------------------------------------------------
# 3. Retained Legacy Channel: SMS (Disabled by default)
# ------------------------------------------------------------------------------
SMS_PROVIDER=mock
SMS_ENABLE_REAL_DELIVERY=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 4. Authorized Staff Emergency Contacts (Placeholders / Server-Side Only)
# ------------------------------------------------------------------------------
STAFF_EMAIL_FACILITY_MGR=
STAFF_PHONE_FACILITY_MGR=
STAFF_WHATSAPP_FACILITY_MGR=

STAFF_EMAIL_SAFETY_OFFICER=
STAFF_PHONE_SAFETY_OFFICER=
STAFF_WHATSAPP_SAFETY_OFFICER=
